{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["bun-types", "@cloudflare/workers-types", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": [
		"apps/**/*",
		"packages/**/*",
		"scripts/**/*.ts",
		"scripts/**/*.tsx",
		"tests/**/*",
		"worker/**/*",
		"*.js",
		"*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
