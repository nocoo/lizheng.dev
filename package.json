{
	"name": "lizheng.dev",
	"version": "2.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun run build.js",
		"dev": "bun run build.js && bun --hot serve.js",
		"serve": "bun run build.js && bunx serve dist",
		"deploy": "wrangler deploy",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "bunx biome check --error-on-warnings .",
		"lint:fix": "bunx biome check --write .",
		"typecheck": "bunx tsc --noEmit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@cloudflare/workers-types": "^4.20260423.1",
		"@types/bun": "latest",
		"@vitest/coverage-v8": "^4.1.5",
		"husky": "^9.1.7",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"wrangler": "^4.71.0"
	}
}
