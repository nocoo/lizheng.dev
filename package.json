{
	"name": "lizheng.dev",
	"version": "2.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun run build.js",
		"dev": "bun --watch scripts/dev.ts",
		"dev:legacy": "bun run build.js && bun --hot serve.js",
		"build:design": "bun scripts/build-design.tsx",
		"assets:design": "bun scripts/create-portraits.ts",
		"review:design": "bun scripts/review-design.ts",
		"serve": "bun run build.js && bunx serve dist",
		"deploy": "wrangler deploy",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "bunx biome check --error-on-warnings .",
		"lint:fix": "bunx biome check --write .",
		"typecheck": "bunx tsc --noEmit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@cloudflare/workers-types": "4.20260616.1",
		"@playwright/test": "1.63.0",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "4.1.9",
		"husky": "9.1.7",
		"sharp": "0.35.4",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.9"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@fontsource-variable/source-sans-3": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@fontsource/silkscreen": "5.3.0",
		"gray-matter": "4.0.3",
		"marked": "18.0.11",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"wrangler": "4.100.0"
	},
	"overrides": {
		"ws": ">=8.21.0",
		"esbuild": ">=0.28.1",
		"vite": "8.2.2",
		"undici": ">=7.28.0"
	}
}
