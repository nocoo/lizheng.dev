{
	"name": "lizheng.dev",
	"version": "3.1.5",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun scripts/build.tsx",
		"dev": "bun scripts/dev.ts",
		"build:design": "bun scripts/build.tsx .design-dist",
		"assets:design": "bun scripts/create-portraits.ts",
		"assets:social": "bun scripts/create-social.tsx",
		"review:design": "bun scripts/review-design.ts",
		"deploy": "wrangler deploy",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "bunx biome check --error-on-warnings .",
		"lint:fix": "bunx biome check --write .",
		"typecheck": "bunx tsc --noEmit",
		"prepare": "husky",
		"types:generate": "wrangler types --strict-vars=false",
		"types:check": "wrangler types --strict-vars=false --check",
		"test:http": "env -u NO_COLOR playwright test --config playwright.http.config.ts",
		"test:browser": "env -u NO_COLOR playwright test",
		"check:static": "bun scripts/gates.ts static",
		"check:staged": "gitleaks protect --staged --no-banner --redact",
		"check:security": "bun scripts/gates.ts security",
		"check:deps": "knip --no-progress --no-config-hints",
		"check:docs": "bun scripts/check-docs.ts",
		"gate:commit": "bun scripts/gates.ts pre-commit",
		"gate:push": "bun scripts/gates.ts pre-push",
		"check:budgets": "bun scripts/check-budgets.ts",
		"check:hooks": "bun scripts/verify-hooks.ts",
		"test:performance": "env -u NO_COLOR playwright test --config playwright.performance.config.ts",
		"test:development": "env -u NO_COLOR playwright test --config playwright.development.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "1.63.0",
		"@types/bun": "1.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.0",
		"husky": "9.1.7",
		"jsdom": "30.0.1",
		"knip": "6.34.0",
		"miniflare": "5.20260903.0-alpha",
		"sharp": "0.35.4",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "5.0.0",
		"wrangler": "4.129.0"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@fontsource-variable/source-sans-3": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@fontsource/silkscreen": "5.3.0",
		"marked": "18.0.11",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=26.0.0",
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0"
}
